{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Alisa007/business-obligations/schema/compliance-result.schema.json",
  "title": "Compliance result",
  "description": "Output of evaluate(): the items, resolved profile and metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "profile",
    "asOf",
    "dataVersion",
    "rulesetVersion",
    "upcomingChanges",
    "recentChanges",
    "disclaimer"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "profile": {
      "type": "object",
      "description": "Business profile with defaults applied."
    },
    "asOf": {
      "$ref": "common.schema.json#/$defs/isoDate"
    },
    "dataVersion": {
      "$ref": "common.schema.json#/$defs/isoDate"
    },
    "rulesetVersion": {
      "$ref": "common.schema.json#/$defs/rulesetVersion"
    },
    "upcomingChanges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/notice"
      }
    },
    "recentChanges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/notice"
      }
    },
    "disclaimer": {
      "type": "string"
    }
  },
  "$defs": {
    "due": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/dueFixed"
        },
        {
          "$ref": "common.schema.json#/$defs/dueAnniversary"
        },
        {
          "$ref": "common.schema.json#/$defs/dueMulti"
        },
        {
          "$ref": "common.schema.json#/$defs/dueDate"
        }
      ]
    },
    "cost": {
      "type": "object",
      "required": ["basis", "currency"],
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": ["flat", "per_partner", "per_member", "percent", "varies", "none", "unknown"]
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "online": {
          "type": "number",
          "minimum": 0
        },
        "paper": {
          "type": "number",
          "minimum": 0
        },
        "rate": {
          "type": "number",
          "minimum": 0
        },
        "base": {
          "type": "number",
          "minimum": 0
        },
        "perUnit": {
          "type": "number",
          "minimum": 0
        },
        "freeUnits": {
          "type": "number",
          "minimum": 0
        },
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "waived": {
          "type": "boolean"
        },
        "estimate": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "currency": {
          "const": "USD"
        }
      }
    },
    "penalty": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis", "amount", "currency"],
          "properties": {
            "basis": { "const": "flat" },
            "amount": { "type": "number", "minimum": 0 },
            "percentPerMonth": { "type": "number", "minimum": 0 },
            "note": { "type": "string" },
            "currency": { "const": "USD" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis", "rate", "currency"],
          "properties": {
            "basis": { "const": "percent" },
            "rate": { "type": "number", "minimum": 0 },
            "base": { "type": "number", "minimum": 0 },
            "min": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 },
            "percentPerMonth": { "type": "number", "minimum": 0 },
            "note": { "type": "string" },
            "currency": { "const": "USD" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis", "perUnit", "currency"],
          "properties": {
            "basis": { "const": "per_item" },
            "perUnit": { "type": "number", "minimum": 0 },
            "min": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 },
            "percentPerMonth": { "type": "number", "minimum": 0 },
            "note": { "type": "string" },
            "currency": { "const": "USD" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis", "min", "currency"],
          "properties": {
            "basis": { "const": "range" },
            "min": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 },
            "percentPerMonth": { "type": "number", "minimum": 0 },
            "note": { "type": "string" },
            "currency": { "const": "USD" }
          }
        }
      ]
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "effective", "status", "kind", "summary"],
      "properties": {
        "id": {
          "type": "string"
        },
        "effective": {
          "$ref": "common.schema.json#/$defs/isoDate"
        },
        "status": {
          "enum": ["enacted", "proposed"]
        },
        "kind": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ruleId",
        "title",
        "category",
        "jurisdiction",
        "authority",
        "description",
        "frequency",
        "cost",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "ruleId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "category": {
          "enum": ["license", "permit", "registration", "filing", "payment", "insurance", "recordkeeping"]
        },
        "jurisdiction": {
          "enum": ["federal", "state", "county", "city"]
        },
        "authority": {
          "type": "string"
        },
        "state": {
          "$ref": "common.schema.json#/$defs/stateCode"
        },
        "description": {
          "type": "string"
        },
        "frequency": {
          "enum": [
            "once",
            "annual",
            "biennial",
            "every_three_years",
            "every_five_years",
            "semiannual",
            "quarterly",
            "monthly",
            "per_event",
            "ongoing"
          ]
        },
        "deadline": {
          "type": "string"
        },
        "due": {
          "$ref": "#/$defs/due"
        },
        "nextDue": {
          "$ref": "common.schema.json#/$defs/isoDate"
        },
        "recurrence": {
          "description": "iCalendar (RFC 5545) RRULE value for annual fixed-date deadlines, always with a concrete month and day.",
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/rrule"
            },
            {
              "pattern": "BYMONTH=.*BYMONTHDAY="
            }
          ]
        },
        "cost": {
          "$ref": "#/$defs/cost"
        },
        "penalty": {
          "$ref": "#/$defs/penalty"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["confidence", "sources"],
          "properties": {
            "confidence": {
              "enum": ["checked", "compiled", "unconfirmed"]
            },
            "checkedOn": {
              "$ref": "common.schema.json#/$defs/isoDate"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reviewBy": {
              "$ref": "common.schema.json#/$defs/isoDate"
            },
            "stale": {
              "type": "boolean"
            },
            "sourceDetails": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["url", "kind", "archiveUrl"],
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": ["statute", "ordinance", "agency_page", "pdf", "dataset"]
                  },
                  "retrievedOn": {
                    "$ref": "common.schema.json#/$defs/isoDate"
                  },
                  "archiveUrl": {
                    "type": "string"
                  }
                }
              }
            },
            "compiledOn": {
              "$ref": "common.schema.json#/$defs/isoDate"
            }
          }
        },
        "upcomingChanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/notice"
          }
        },
        "reason": {
          "type": "string"
        },
        "url": {
          "$ref": "common.schema.json#/$defs/httpsUrlOrList"
        },
        "appliesWhen": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "op", "value"],
            "properties": {
              "field": {
                "type": "string"
              },
              "op": {
                "enum": [">=", ">", "<=", "<", "==", "!=", "in"]
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "appliesWhenAny": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "op", "value"],
            "properties": {
              "field": { "type": "string" },
              "op": { "enum": [">=", ">", "<=", "<", "==", "!=", "in"] },
              "value": {
                "anyOf": [
                  { "type": "string" },
                  { "type": "number" },
                  { "type": "boolean" },
                  { "type": "array", "items": { "type": "string" } }
                ]
              },
              "description": { "type": "string" }
            }
          }
        },
        "exemptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preemptedBy": {
          "type": "string"
        },
        "jurisdictionId": {
          "type": "string"
        },
        "stateFips": {
          "type": "string"
        },
        "formId": {
          "type": "string"
        },
        "processingTime": {
          "type": "string"
        },
        "renewal": {
          "type": "string"
        },
        "feedbackUrl": {
          "type": "string"
        },
        "filingMethod": {
          "type": "array",
          "items": {
            "enum": ["online", "mail", "in_person", "fax"]
          }
        },
        "fips": {
          "type": "string",
          "pattern": "^\\d{5}$|^\\d{7}$"
        },
        "incorporated": {
          "type": "boolean"
        }
      }
    }
  }
}
