{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Alisa007/business-obligations/schema/local-item.schema.json",
  "title": "City or county obligation",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "category", "authority", "description", "url", "appliesTo"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "<place>.<obligation>, lower-case and hyphenated."
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "pattern": "^\\S(.*\\S)?$"
    },
    "category": {
      "enum": ["license", "permit", "registration", "filing", "payment", "insurance", "recordkeeping"]
    },
    "authority": {
      "type": "string",
      "minLength": 3,
      "pattern": "^\\S(.*\\S)?$"
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "pattern": "^\\S(.*\\S)?$"
    },
    "frequency": {
      "enum": [
        "once",
        "annual",
        "biennial",
        "every_five_years",
        "quarterly",
        "monthly",
        "per_event",
        "ongoing"
      ]
    },
    "deadline": {
      "type": "string",
      "minLength": 3,
      "pattern": "^\\S(.*[^\\s.])?$",
      "description": "Full deadline text, only for what the rule cannot say. Generated from rrule when omitted."
    },
    "deadlineNote": {
      "type": "string",
      "minLength": 3,
      "description": "Qualifier shown in parentheses after the generated deadline (\"calendar-year filers\"). Must not repeat the rule's own date."
    },
    "url": {
      "$ref": "common.schema.json#/$defs/httpsUrl"
    },
    "appliesTo": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["all", "employees", "sells_goods", "corporation", "unincorporated", "trade_name"]
      }
    },
    "appliesWhen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "op", "value"],
        "properties": {
          "field": {
            "type": "string"
          },
          "op": {
            "enum": [">=", ">", "<=", "<", "==", "!=", "in"]
          },
          "value": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "exemptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersedes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "preemptedBy": {
      "type": "string",
      "minLength": 1
    },
    "formId": {
      "type": "string",
      "minLength": 1
    },
    "filingMethod": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["online", "mail", "in_person", "fax"]
      }
    },
    "processingTime": {
      "type": "string",
      "minLength": 3
    },
    "renewal": {
      "type": "string",
      "minLength": 3
    },
    "rrule": {
      "$ref": "common.schema.json#/$defs/rrule",
      "description": "iCalendar (RFC 5545) recurrence rule. The source of truth for frequency and due date; see src/rrule.ts for the supported subset."
    },
    "anchor": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/isoDate"
        },
        {
          "enum": ["formation_year", "year_after_formation"]
        }
      ],
      "description": "Start of a cycle longer than a year: an ISO date, or the entity's formation year or the year after."
    },
    "opens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["month", "day"],
      "properties": {
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        }
      },
      "description": "The day a filing window opens; the rule's date is the day it closes. Gives text such as \"January 1 – May 1\"."
    }
  },
  "anyOf": [
    {
      "required": ["rrule"]
    },
    {
      "required": ["frequency"]
    }
  ],
  "allOf": [
    {
      "if": {
        "required": ["rrule"]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": ["frequency"]
            },
            {
              "required": ["due"]
            }
          ]
        }
      },
      "else": {
        "not": {
          "required": ["anchor"]
        }
      }
    }
  ]
}
