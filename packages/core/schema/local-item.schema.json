{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Alisa007/business-obligations/schema/local-item.schema.json",
  "title": "City or county obligation",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "category", "authority", "description", "frequency", "appliesTo"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "<place>.<obligation>, lower-case and hyphenated."
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "pattern": "^\\S(.*\\S)?$"
    },
    "category": {
      "enum": ["license", "permit", "registration", "filing", "payment", "insurance", "recordkeeping"]
    },
    "authority": {
      "type": "string",
      "minLength": 3,
      "pattern": "^\\S(.*\\S)?$"
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "pattern": "^\\S(.*\\S)?$"
    },
    "frequency": {
      "enum": ["once", "annual", "biennial", "quarterly", "monthly", "per_event", "ongoing"]
    },
    "deadline": {
      "type": "string",
      "minLength": 3,
      "pattern": "^\\S(.*[^\\s.])?$",
      "description": "Human-readable deadline; month names in full (\"April 15\"). Machine form goes in `due`."
    },
    "due": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "date"],
          "properties": {
            "type": {
              "const": "date"
            },
            "date": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "month", "day"],
          "properties": {
            "type": {
              "const": "fixed"
            },
            "month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31
            },
            "parity": {
              "enum": ["odd", "even"]
            },
            "cycleFrom": {
              "enum": ["formation_year", "year_after_formation"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "dates"],
          "properties": {
            "type": {
              "const": "multi"
            },
            "dates": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["month", "day"],
                "properties": {
                  "month": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12
                  },
                  "day": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 31
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "point"],
          "properties": {
            "type": {
              "const": "anniversary"
            },
            "point": {
              "enum": ["start_of_month", "end_of_month", "date"]
            }
          }
        }
      ]
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "appliesTo": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["all", "employees", "sells_goods", "corporation", "unincorporated", "trade_name"]
      }
    },
    "appliesWhen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "op", "value"],
        "properties": {
          "field": {
            "type": "string"
          },
          "op": {
            "enum": [">=", ">", "<=", "<", "==", "!=", "in"]
          },
          "value": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "exemptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersedes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "preemptedBy": {
      "type": "string",
      "minLength": 1
    },
    "formId": {
      "type": "string",
      "minLength": 1
    },
    "filingMethod": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["online", "mail", "in_person", "fax"]
      }
    },
    "processingTime": {
      "type": "string",
      "minLength": 3
    },
    "renewal": {
      "type": "string",
      "minLength": 3
    }
  }
}
