{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Alisa007/business-obligations/schema/changes.schema.json",
  "title": "Rule change registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["rulesetVersion", "changes"],
  "properties": {
    "rulesetVersion": {
      "$ref": "common.schema.json#/$defs/rulesetVersion"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "effective", "status", "kind", "summary", "scope"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]+$"
          },
          "effective": {
            "$ref": "common.schema.json#/$defs/isoDate"
          },
          "announced": {
            "$ref": "common.schema.json#/$defs/isoDate"
          },
          "status": {
            "enum": ["enacted", "proposed"]
          },
          "kind": {
            "enum": ["fee", "deadline", "requirement", "repeal", "threshold", "enforcement", "other"]
          },
          "summary": {
            "type": "string",
            "minLength": 10
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "country": {
                "const": "US"
              },
              "state": {
                "$ref": "common.schema.json#/$defs/stateCode"
              },
              "rules": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            }
          },
          "patches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "value"],
              "properties": {
                "path": {
                  "type": "string"
                },
                "value": {}
              }
            }
          },
          "source": {
            "$ref": "common.schema.json#/$defs/httpsUrl"
          }
        }
      }
    }
  }
}
