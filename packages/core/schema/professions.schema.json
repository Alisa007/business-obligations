{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Alisa007/business-obligations/schema/professions.schema.json",
  "title": "Professional licensing boards",
  "type": "object",
  "additionalProperties": false,
  "required": ["verification", "professions"],
  "properties": {
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkedOn", "scope", "unconfirmed"],
      "properties": {
        "checkedOn": {
          "$ref": "common.schema.json#/$defs/isoDate"
        },
        "scope": {
          "type": "string",
          "minLength": 10
        },
        "unconfirmed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "professions": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "enum": ["attorney", "cpa", "physician", "architect", "engineer"]
      },
      "patternProperties": {
        "^[a-z]+$": {
          "type": "object",
          "additionalProperties": false,
          "propertyNames": { "$ref": "common.schema.json#/$defs/stateCode" },
          "minProperties": 51,
          "patternProperties": {
            "^[A-Z]{2}$": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 6
                },
                "url": {
                  "$ref": "common.schema.json#/$defs/httpsUrl"
                }
              }
            }
          }
        }
      }
    }
  }
}
