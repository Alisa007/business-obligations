{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Alisa007/business-obligations/schema/state.schema.json",
  "title": "State rule data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "filing",
    "revenue",
    "labor",
    "workersComp",
    "llcReport",
    "corpReport",
    "entityTax",
    "salesTax",
    "businessLicense",
    "paidLeave",
    "paidSickLeave",
    "local",
    "llcPublication",
    "economicNexusUsd",
    "dbaFiling",
    "industry",
    "verification",
    "cannabis",
    "localSalesTax",
    "unemployment",
    "links"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "dbaFiling": {
            "enum": ["county", "town"]
          }
        }
      },
      "then": {
        "required": ["dbaOffice"]
      }
    }
  ],
  "properties": {
    "name": {
      "description": "Full state name.",
      "type": "string",
      "minLength": 2
    },
    "filing": {
      "description": "Agency where entities are formed and reports are filed.",
      "$ref": "#/$defs/agency"
    },
    "revenue": {
      "description": "Primary tax agency (income/franchise, and sales tax unless salesTax.agency is set).",
      "$ref": "#/$defs/agency"
    },
    "labor": {
      "description": "Unemployment insurance agency.",
      "$ref": "#/$defs/agency"
    },
    "llcReport": {
      "description": "Periodic report required of LLCs formed in the state; null = none.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/report"
        }
      ]
    },
    "corpReport": {
      "description": "Periodic report required of corporations and nonprofits formed in the state; null = none.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/report"
        }
      ]
    },
    "lpReport": {
      "description": "Report for limited partnerships when it differs from the LLC report; null = none, absent = same as LLC.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/report"
        }
      ]
    },
    "llpReport": {
      "description": "Report for limited liability partnerships when it differs from the LLC report; null = none, absent = same as LLC.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/report"
        }
      ]
    },
    "llcReportAppliesWhenTaxedAsCorp": {
      "description": "LLCs taxed as corporations must file the corporate report even though plain LLCs do not (SC).",
      "type": "boolean"
    },
    "llcPublication": {
      "description": "Post-formation newspaper publication requirement for LLCs; null = none.",
      "type": ["string", "null"]
    },
    "entityTax": {
      "description": "Entity-level income, franchise or gross-receipts taxes, in words.",
      "type": "string",
      "minLength": 3
    },
    "entityTaxDetail": {
      "description": "Threshold and rate of the state's gross-receipts or margin tax, where it is modelled.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "thresholdUsd", "summary", "source", "checkedOn"],
      "properties": {
        "kind": {
          "enum": ["gross_receipts", "margin"]
        },
        "thresholdUsd": {
          "type": "number",
          "minimum": 0
        },
        "rate": {
          "type": "number",
          "minimum": 0
        },
        "baseUsd": {
          "type": "number",
          "minimum": 0
        },
        "summary": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/httpsUrl"
        },
        "checkedOn": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "salesTax": {
      "description": "Statewide sales and use tax regime.",
      "type": "object",
      "additionalProperties": false,
      "required": ["statewide", "permit", "agency", "alternative"],
      "properties": {
        "statewide": {
          "type": "boolean"
        },
        "permit": {
          "type": "string",
          "minLength": 3
        },
        "agency": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/agency"
            }
          ]
        },
        "alternative": {
          "type": ["string", "null"]
        }
      }
    },
    "localSalesTax": {
      "description": "Who administers local (city/county) sales taxes.",
      "enum": ["locally_administered", "state_administered", "none"]
    },
    "economicNexusUsd": {
      "description": "Annual sales into the state, in USD, at which a remote seller must register; null = no statewide sales tax.",
      "type": ["integer", "null"],
      "minimum": 1
    },
    "unemployment": {
      "description": "State unemployment insurance (SUI) employer tax parameters; the data year is in data/ui-source.json.",
      "type": "object",
      "additionalProperties": false,
      "required": ["wageBase", "minRate", "maxRate", "newEmployerRate"],
      "properties": {
        "wageBase": {
          "type": "integer",
          "minimum": 1000,
          "description": "Annual wages per employee subject to the tax, USD."
        },
        "minRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 30,
          "description": "Lowest experience-rated contribution rate, in percent (2.7 means 2.7%)."
        },
        "maxRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 30,
          "description": "Highest experience-rated contribution rate, in percent."
        },
        "newEmployerRate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 30,
          "description": "Rate for new employers, in percent; null when it depends on the employer's industry average."
        },
        "note": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "workersComp": {
      "description": "Workers' compensation coverage requirement.",
      "type": "object",
      "additionalProperties": false,
      "required": ["agency", "stateFund", "trigger"],
      "properties": {
        "agency": {
          "type": "string",
          "minLength": 3
        },
        "threshold": {
          "type": "string",
          "minLength": 3,
          "description": "Threshold in words. Stored only when it says more than the employee count; otherwise generated from trigger."
        },
        "stateFund": {
          "type": "boolean",
          "description": "Coverage must be bought from an exclusive state fund."
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minEmployees"],
          "properties": {
            "minEmployees": {
              "type": "integer",
              "minimum": 1,
              "description": "Employees at which coverage becomes mandatory."
            },
            "constructionMinEmployees": {
              "type": "integer",
              "minimum": 1,
              "description": "Lower employee threshold in construction."
            },
            "orFullTimeEmployees": {
              "type": "integer",
              "minimum": 1,
              "description": "Alternative: this many full-time (35+ hour) employees makes coverage mandatory."
            },
            "orAnnualPayroll": {
              "type": "number",
              "minimum": 0,
              "description": "Alternative: annual payroll at or above this makes coverage mandatory."
            },
            "andAnnualPayrollOver": {
              "type": "number",
              "minimum": 0,
              "description": "Payroll that must be exceeded in addition to the employee count."
            },
            "andAnnualPayrollAtLeast": {
              "type": "number",
              "minimum": 0,
              "description": "Payroll that must be reached (at or above) in addition to the employee count."
            },
            "elective": {
              "type": "boolean",
              "description": "Coverage is elective for private employers."
            }
          }
        }
      }
    },
    "paidLeave": {
      "description": "Mandatory state paid-leave or disability program with employer duties; null = none.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "agency", "description", "minEmployees"],
          "properties": {
            "title": {
              "type": "string"
            },
            "agency": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "minEmployees": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "paidSickLeave": {
      "description": "Statewide paid sick leave mandate; null = none.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["minEmployees"],
          "properties": {
            "minEmployees": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "businessLicense": {
      "description": "General state-level business license; null = the state has none.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "authority", "renewal", "feeDetail"],
          "properties": {
            "title": {
              "type": "string"
            },
            "authority": {
              "type": "string"
            },
            "url": {
              "$ref": "#/$defs/httpsUrl"
            },
            "fee": {
              "type": "string",
              "minLength": 1,
              "description": "Fee text; stored only when feeDetail cannot say it all, otherwise generated from feeDetail."
            },
            "renewal": {
              "enum": ["annual", "biennial", "once"]
            },
            "feeDetail": {
              "$ref": "#/$defs/feeDetail"
            }
          }
        }
      ]
    },
    "local": {
      "description": "Typical general local licensing in the state.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "authority", "description"],
      "properties": {
        "title": {
          "type": "string"
        },
        "authority": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "dbaFiling": {
      "description": "Where a sole proprietor's trade name (DBA) is registered; none = no filing required.",
      "enum": ["state", "county", "town", "none"]
    },
    "dbaEntitiesFileLocally": {
      "description": "Registered entities also file assumed names at the county or town level.",
      "type": "boolean"
    },
    "dbaOffice": {
      "description": "Name of the county or town office when dbaFiling is county or town.",
      "type": "string"
    },
    "dbaAuthority": {
      "description": "State agency taking trade names when it is not the entity filing agency.",
      "$ref": "#/$defs/agency"
    },
    "industry": {
      "description": "State licensing authorities by industry.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractor", "realEstate", "alcohol", "childCare", "health"],
      "properties": {
        "contractor": {
          "type": ["string", "null"]
        },
        "realEstate": {
          "type": "string",
          "minLength": 3
        },
        "alcohol": {
          "type": "string",
          "minLength": 3
        },
        "childCare": {
          "type": "string",
          "minLength": 3
        },
        "health": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "cannabis": {
      "description": "State cannabis licensing regime.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "regulator"],
      "properties": {
        "status": {
          "enum": ["adult_use", "medical_only", "cbd_only"]
        },
        "regulator": {
          "type": ["string", "null"]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "links": {
      "description": "Specific agency pages (not home pages) for the obligations the rules cite.",
      "type": "object",
      "additionalProperties": false,
      "required": ["formation", "annualReport", "uiRegistration", "entityTax", "laborPosters"],
      "properties": {
        "formation": {
          "$ref": "#/$defs/httpsUrl"
        },
        "annualReport": {
          "$ref": "#/$defs/httpsUrl"
        },
        "uiRegistration": {
          "$ref": "#/$defs/httpsUrl"
        },
        "withholding": {
          "$ref": "#/$defs/httpsUrl"
        },
        "salesTax": {
          "$ref": "#/$defs/httpsUrl"
        },
        "entityTax": {
          "$ref": "#/$defs/httpsUrl"
        },
        "laborPosters": {
          "$ref": "#/$defs/httpsUrl"
        },
        "dba": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "verification": {
      "description": "What was checked, when, and against which sources.",
      "type": "object",
      "additionalProperties": false,
      "required": ["checkedOn", "sources", "unconfirmed"],
      "properties": {
        "checkedOn": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date (YYYY-MM-DD) of the review."
        },
        "scope": {
          "type": "string",
          "minLength": 10,
          "description": "What the review covered. Stored only when it differs from the shared text in data/verification.json."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/httpsUrl"
          },
          "description": "Official pages the review relied on."
        },
        "unconfirmed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z]+(\\.[A-Za-z]+)*$"
          },
          "description": "Dotted field paths that could not be confirmed against an official source (checked against the data by a test). dbaFiling here means the DBA level is unconfirmed."
        }
      }
    }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "description": "An https URL."
    },
    "agency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "due": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "date"],
          "properties": {
            "type": {
              "const": "date"
            },
            "date": {
              "type": "string",
              "format": "date"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "month", "day"],
          "properties": {
            "type": {
              "const": "fixed"
            },
            "month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31
            },
            "parity": {
              "enum": ["odd", "even"]
            },
            "cycleFrom": {
              "enum": ["formation_year", "year_after_formation"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "point"],
          "properties": {
            "type": {
              "const": "anniversary"
            },
            "point": {
              "enum": ["start_of_month", "end_of_month", "date"]
            }
          }
        }
      ]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feeDetail"],
      "properties": {
        "title": {
          "type": "string"
        },
        "rrule": {
          "type": "string",
          "pattern": "^FREQ=YEARLY(;INTERVAL=[25])?(;BYMONTH=\\d{1,2}(,\\d{1,2})*)?(;BYMONTHDAY=-?\\d{1,2})?$",
          "description": "iCalendar (RFC 5545) recurrence rule. The source of truth for frequency and due date; see src/rrule.ts for the supported subset."
        },
        "anchor": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "enum": ["formation_year", "year_after_formation"]
            }
          ],
          "description": "Start of a cycle longer than a year: an ISO date, or the entity's formation year or the year after."
        },
        "frequency": {
          "enum": ["annual", "biennial", "every_five_years", "periodic"]
        },
        "deadline": {
          "type": "string",
          "minLength": 1,
          "description": "Display text; generated from rrule when omitted."
        },
        "fee": {
          "type": "string",
          "minLength": 1,
          "description": "Fee text; stored only when feeDetail cannot say it all (a waiver, an estimate, a rate), otherwise generated from feeDetail."
        },
        "feeDetail": {
          "$ref": "#/$defs/feeDetail"
        },
        "lateFee": {
          "$ref": "#/$defs/lateFee"
        },
        "due": {
          "$ref": "#/$defs/due"
        }
      },
      "anyOf": [
        {
          "required": ["rrule"]
        },
        {
          "required": ["frequency", "deadline"]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": ["rrule"]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["frequency"]
                },
                {
                  "required": ["due"]
                }
              ]
            }
          },
          "else": {
            "not": {
              "required": ["anchor"]
            }
          }
        }
      ]
    },
    "feeDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis"],
      "properties": {
        "basis": {
          "enum": ["flat", "per_partner", "per_member", "percent", "varies", "none"]
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "online": {
          "type": "number",
          "minimum": 0
        },
        "paper": {
          "type": "number",
          "minimum": 0
        },
        "rate": {
          "type": "number",
          "minimum": 0
        },
        "base": {
          "type": "number",
          "minimum": 0
        },
        "perUnit": {
          "type": "number",
          "minimum": 0
        },
        "freeUnits": {
          "type": "integer",
          "minimum": 0
        },
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "waived": {
          "type": "boolean"
        },
        "estimate": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "lateFee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "note"],
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "percentPerMonth": {
          "type": "number",
          "minimum": 0
        },
        "note": {
          "type": "string"
        }
      }
    }
  },
  "description": "One state's rule data (data/states/<XX>.json; the file name is the state code)."
}
