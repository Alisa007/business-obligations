{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Alisa007/business-obligations/schema/state.schema.json",
  "title": "State rule data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "filing",
    "revenue",
    "labor",
    "workersComp",
    "llcReport",
    "corpReport",
    "entityTax",
    "salesTax",
    "businessLicense",
    "paidLeave",
    "paidSickLeave",
    "local",
    "llcPublication",
    "economicNexusUsd",
    "dbaFiling",
    "industry",
    "verification",
    "cannabis",
    "localSalesTax",
    "unemployment",
    "links"
  ],
  "allOf": [
    {
      "if": { "properties": { "dbaFiling": { "enum": ["county", "town"] } } },
      "then": { "required": ["dbaOffice"] }
    }
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2
    },
    "filing": {
      "$ref": "#/$defs/agency"
    },
    "revenue": {
      "$ref": "#/$defs/agency"
    },
    "labor": {
      "$ref": "#/$defs/agency"
    },
    "workersComp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agency", "threshold", "stateFund", "trigger"],
      "properties": {
        "agency": {
          "type": "string",
          "minLength": 3
        },
        "threshold": {
          "type": "string",
          "minLength": 3
        },
        "stateFund": {
          "type": "boolean"
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minEmployees"],
          "properties": {
            "minEmployees": {
              "type": "integer",
              "minimum": 1
            },
            "orAnnualPayroll": {
              "type": "number",
              "minimum": 0
            },
            "andAnnualPayrollOver": {
              "type": "number",
              "minimum": 0
            },
            "constructionMinEmployees": {
              "type": "integer",
              "minimum": 1
            },
            "elective": {
              "type": "boolean"
            },
            "orFullTimeEmployees": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "llcReport": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/report"
        }
      ]
    },
    "corpReport": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/report"
        }
      ]
    },
    "llcReportAppliesWhenTaxedAsCorp": {
      "type": "boolean"
    },
    "entityTax": {
      "type": "string",
      "minLength": 3
    },
    "salesTax": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statewide", "permit", "agency", "alternative"],
      "properties": {
        "statewide": {
          "type": "boolean"
        },
        "permit": {
          "type": "string",
          "minLength": 3
        },
        "agency": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/agency"
            }
          ]
        },
        "alternative": {
          "type": ["string", "null"]
        }
      }
    },
    "businessLicense": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "authority", "renewal", "feeDetail"],
          "properties": {
            "title": {
              "type": "string"
            },
            "authority": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "fee": {
              "type": "string",
              "minLength": 1,
              "description": "Fee text; stored only when feeDetail cannot say it all, otherwise generated from feeDetail."
            },
            "renewal": {
              "enum": ["annual", "biennial", "once"]
            },
            "feeDetail": {
              "$ref": "#/$defs/feeDetail"
            }
          }
        }
      ]
    },
    "paidLeave": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "agency", "description", "minEmployees"],
          "properties": {
            "title": {
              "type": "string"
            },
            "agency": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "minEmployees": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "paidSickLeave": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["minEmployees"],
          "properties": {
            "minEmployees": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "local": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "authority", "description"],
      "properties": {
        "title": {
          "type": "string"
        },
        "authority": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "llcPublication": {
      "type": ["string", "null"]
    },
    "economicNexusUsd": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "dbaEntitiesFileLocally": {
      "type": "boolean"
    },
    "dbaFiling": {
      "enum": ["state", "county", "town", "none"]
    },
    "industry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractor", "realEstate", "alcohol", "childCare", "health"],
      "properties": {
        "contractor": {
          "type": ["string", "null"]
        },
        "realEstate": {
          "type": "string",
          "minLength": 3
        },
        "alcohol": {
          "type": "string",
          "minLength": 3
        },
        "childCare": {
          "type": "string",
          "minLength": 3
        },
        "health": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkedOn", "scope", "sources", "unconfirmed", "dba"],
      "properties": {
        "checkedOn": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "scope": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        },
        "unconfirmed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dba": {
          "enum": ["checked", "unconfirmed"]
        }
      }
    },
    "dbaOffice": {
      "type": "string"
    },
    "dbaAuthority": {
      "$ref": "#/$defs/agency"
    },
    "lpReport": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/report"
        }
      ]
    },
    "llpReport": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/report"
        }
      ]
    },
    "cannabis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "regulator"],
      "properties": {
        "status": {
          "enum": ["adult_use", "medical_only", "cbd_only"]
        },
        "regulator": {
          "type": ["string", "null"]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "localSalesTax": {
      "enum": ["locally_administered", "state_administered", "none"]
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formation", "annualReport", "uiRegistration", "entityTax", "laborPosters"],
      "properties": {
        "formation": { "type": "string", "format": "uri" },
        "annualReport": { "type": "string", "format": "uri" },
        "uiRegistration": { "type": "string", "format": "uri" },
        "withholding": { "type": "string", "format": "uri" },
        "salesTax": { "type": "string", "format": "uri" },
        "entityTax": { "type": "string", "format": "uri" },
        "laborPosters": { "type": "string", "format": "uri" },
        "dba": { "type": "string", "format": "uri" }
      }
    },
    "entityTaxDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "thresholdUsd", "summary", "source", "checkedOn"],
      "properties": {
        "kind": { "enum": ["gross_receipts", "margin"] },
        "thresholdUsd": { "type": "number", "minimum": 0 },
        "rate": { "type": "number", "minimum": 0 },
        "baseUsd": { "type": "number", "minimum": 0 },
        "summary": { "type": "string" },
        "source": { "type": "string", "format": "uri" },
        "checkedOn": { "type": "string", "format": "date" }
      }
    },
    "unemployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wageBase", "minRate", "maxRate", "newEmployerRate"],
      "properties": {
        "wageBase": { "type": "number", "minimum": 0 },
        "minRate": { "type": "number", "minimum": 0 },
        "maxRate": { "type": "number", "minimum": 0 },
        "newEmployerRate": { "type": ["number", "null"], "minimum": 0 },
        "note": { "type": "string" }
      }
    }
  },
  "$defs": {
    "agency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "due": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "date"],
          "properties": {
            "type": { "const": "date" },
            "date": { "type": "string", "format": "date" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "month", "day"],
          "properties": {
            "type": {
              "const": "fixed"
            },
            "month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31
            },
            "parity": {
              "enum": ["odd", "even"]
            },
            "cycleFrom": {
              "enum": ["formation_year", "year_after_formation"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "point"],
          "properties": {
            "type": {
              "const": "anniversary"
            },
            "point": {
              "enum": ["start_of_month", "end_of_month", "date"]
            }
          }
        }
      ]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feeDetail"],
      "properties": {
        "frequency": {
          "enum": ["annual", "biennial", "every_five_years", "periodic"]
        },
        "fee": {
          "type": "string",
          "minLength": 1,
          "description": "Fee text; stored only when feeDetail cannot say it all (a waiver, an estimate, a rate), otherwise generated from feeDetail."
        },
        "deadline": {
          "type": "string",
          "minLength": 1,
          "description": "Display text; generated from rrule when omitted."
        },
        "title": {
          "type": "string"
        },
        "due": {
          "$ref": "#/$defs/due"
        },
        "feeDetail": {
          "$ref": "#/$defs/feeDetail"
        },
        "lateFee": {
          "$ref": "#/$defs/lateFee"
        },
        "rrule": {
          "type": "string",
          "pattern": "^FREQ=YEARLY(;INTERVAL=[25])?(;BYMONTH=\\d{1,2}(,\\d{1,2})*)?(;BYMONTHDAY=-?\\d{1,2})?$",
          "description": "iCalendar (RFC 5545) recurrence rule. The source of truth for frequency and due date; see src/rrule.ts for the supported subset."
        },
        "anchor": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "enum": ["formation_year", "year_after_formation"]
            }
          ],
          "description": "Start of a cycle longer than a year: an ISO date, or the entity's formation year or the year after."
        }
      },
      "anyOf": [
        {
          "required": ["rrule"]
        },
        {
          "required": ["frequency", "deadline"]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": ["rrule"]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["frequency"]
                },
                {
                  "required": ["due"]
                }
              ]
            }
          },
          "else": {
            "not": {
              "required": ["anchor"]
            }
          }
        }
      ]
    },
    "feeDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis"],
      "properties": {
        "basis": {
          "enum": ["flat", "per_partner", "per_member", "percent", "varies", "none"]
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "online": {
          "type": "number",
          "minimum": 0
        },
        "paper": {
          "type": "number",
          "minimum": 0
        },
        "rate": {
          "type": "number",
          "minimum": 0
        },
        "base": {
          "type": "number",
          "minimum": 0
        },
        "perUnit": {
          "type": "number",
          "minimum": 0
        },
        "freeUnits": {
          "type": "integer",
          "minimum": 0
        },
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "waived": {
          "type": "boolean"
        },
        "estimate": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "lateFee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "note"],
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "percentPerMonth": {
          "type": "number",
          "minimum": 0
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
