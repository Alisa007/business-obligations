{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Alisa007/business-obligations/schema/state.schema.json",
  "title": "State rule data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "filing",
    "revenue",
    "labor",
    "llcReport",
    "corpReport",
    "llcReportAppliesWhenTaxedAsCorp",
    "llcPublication",
    "entityTax",
    "wageWithholding",
    "entityTaxDetail",
    "salesTax",
    "localSalesTax",
    "economicNexusUsd",
    "unemployment",
    "workersComp",
    "paidLeave",
    "paidSickLeave",
    "businessLicense",
    "local",
    "dbaFiling",
    "dbaEntitiesFileLocally",
    "industry",
    "cannabis",
    "links",
    "verification"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "dbaFiling": {
            "enum": ["county", "town"]
          }
        }
      },
      "then": {
        "required": ["dbaOffice"]
      }
    }
  ],
  "properties": {
    "name": {
      "description": "Full state name.",
      "type": "string",
      "minLength": 2
    },
    "filing": {
      "description": "Agency where entities are formed and reports are filed.",
      "$ref": "#/$defs/agency"
    },
    "revenue": {
      "description": "Primary tax agency (income/franchise, and sales tax unless salesTax.agency is set).",
      "$ref": "#/$defs/agency"
    },
    "labor": {
      "description": "Unemployment insurance agency.",
      "$ref": "#/$defs/agency"
    },
    "llcReport": {
      "description": "Periodic report required of LLCs formed in the state; null = none.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/report"
        }
      ]
    },
    "corpReport": {
      "description": "Periodic report required of corporations and nonprofits formed in the state; null = none.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/report"
        }
      ]
    },
    "lpReport": {
      "description": "Report for limited partnerships when it differs from the LLC report; null = none, absent = same as LLC.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/report"
        }
      ]
    },
    "llpReport": {
      "description": "Report for limited liability partnerships when it differs from the LLC report; null = none, absent = same as LLC.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/report"
        }
      ]
    },
    "llcReportAppliesWhenTaxedAsCorp": {
      "description": "LLCs taxed as corporations must file the corporate report even though plain LLCs do not (SC).",
      "type": "boolean"
    },
    "llcPublication": {
      "description": "Post-formation newspaper publication requirement for LLCs; null = none.",
      "type": ["string", "null"]
    },
    "entityTax": {
      "description": "Entity-level income, franchise or gross-receipts taxes, in words.",
      "type": "string",
      "minLength": 3
    },
    "wageWithholding": {
      "description": "Whether the state levies individual income tax withholding on wages.",
      "type": "boolean"
    },
    "entityTaxDetail": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "thresholdUsd", "summary", "source", "checkedOn"],
          "properties": {
            "kind": {
              "enum": ["gross_receipts", "margin"]
            },
            "thresholdUsd": {
              "type": "number",
              "minimum": 0
            },
            "rate": {
              "type": "number",
              "minimum": 0
            },
            "baseUsd": {
              "type": "number",
              "minimum": 0
            },
            "summary": {
              "type": "string"
            },
            "source": {
              "$ref": "common.schema.json#/$defs/httpsUrl"
            },
            "checkedOn": {
              "$ref": "common.schema.json#/$defs/isoDate"
            }
          }
        }
      ]
    },
    "salesTax": {
      "description": "Statewide sales and use tax regime.",
      "type": "object",
      "additionalProperties": false,
      "required": ["statewide", "permit", "agency", "alternative"],
      "properties": {
        "statewide": {
          "type": "boolean"
        },
        "permit": {
          "type": "string",
          "minLength": 3
        },
        "agency": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/agency"
            }
          ]
        },
        "alternative": {
          "type": ["string", "null"]
        }
      }
    },
    "localSalesTax": {
      "description": "Who administers local (city/county) sales taxes.",
      "enum": ["locally_administered", "state_administered", "none"]
    },
    "economicNexusUsd": {
      "description": "Annual sales into the state, in USD, at which a remote seller must register; null = no statewide sales tax.",
      "type": ["integer", "null"],
      "minimum": 1
    },
    "unemployment": {
      "description": "State unemployment insurance (SUI) employer tax parameters; the data year is in data/ui-source.json.",
      "type": "object",
      "additionalProperties": false,
      "required": ["wageBase", "minRate", "maxRate", "newEmployerRate"],
      "properties": {
        "wageBase": {
          "type": "integer",
          "minimum": 1000,
          "description": "Annual wages per employee subject to the tax, USD."
        },
        "minRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 30,
          "description": "Lowest experience-rated contribution rate, in percent (2.7 means 2.7%)."
        },
        "maxRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 30,
          "description": "Highest experience-rated contribution rate, in percent."
        },
        "newEmployerRate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 30,
          "description": "Rate for new employers, in percent; null when it depends on the employer's industry average."
        },
        "note": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "workersComp": {
      "description": "Workers' compensation coverage requirement.",
      "type": "object",
      "additionalProperties": false,
      "required": ["agency", "stateFund", "trigger"],
      "properties": {
        "agency": {
          "type": "string",
          "minLength": 3
        },
        "threshold": {
          "type": "string",
          "minLength": 3,
          "description": "Threshold in words. Stored only when it says more than the employee count; otherwise generated from trigger."
        },
        "stateFund": {
          "type": "boolean",
          "description": "Coverage must be bought from an exclusive state fund."
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minEmployees"],
          "properties": {
            "minEmployees": {
              "type": "integer",
              "minimum": 1,
              "description": "Employees at which coverage becomes mandatory."
            },
            "constructionMinEmployees": {
              "type": "integer",
              "minimum": 1,
              "description": "Lower employee threshold in construction."
            },
            "orFullTimeEmployees": {
              "type": "integer",
              "minimum": 1,
              "description": "Alternative: this many full-time (35+ hour) employees makes coverage mandatory."
            },
            "orAnnualPayroll": {
              "type": "number",
              "minimum": 0,
              "description": "Alternative: annual payroll at or above this makes coverage mandatory."
            },
            "andAnnualPayrollOver": {
              "type": "number",
              "minimum": 0,
              "description": "Payroll that must be exceeded in addition to the employee count."
            },
            "andAnnualPayrollAtLeast": {
              "type": "number",
              "minimum": 0,
              "description": "Payroll that must be reached (at or above) in addition to the employee count."
            },
            "elective": {
              "type": "boolean",
              "description": "Coverage is elective for private employers."
            }
          }
        }
      }
    },
    "paidLeave": {
      "description": "Mandatory state paid-leave or disability program with employer duties; null = none.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "agency", "description", "minEmployees"],
          "properties": {
            "title": {
              "type": "string"
            },
            "agency": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "minEmployees": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "paidSickLeave": {
      "description": "Statewide paid sick leave mandate; null = none.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["minEmployees"],
          "properties": {
            "minEmployees": {
              "type": "integer",
              "minimum": 1
            },
            "note": {
              "description": "Replaces the standard sentence when the mandate has tiers (paid or unpaid by size, or by hours worked).",
              "type": "string"
            }
          }
        }
      ]
    },
    "businessLicense": {
      "description": "General state-level business license; null = the state has none.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "authority", "url", "feeDetail", "penalty"],
          "allOf": [{ "$ref": "common.schema.json#/$defs/exactSchedule" }],
          "oneOf": [
            {
              "required": ["rrule"]
            },
            {
              "required": ["frequency"]
            }
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "authority": {
              "type": "string"
            },
            "url": {
              "$ref": "common.schema.json#/$defs/httpsUrlList"
            },
            "fee": {
              "type": "string",
              "minLength": 1,
              "description": "Fee text; stored only when feeDetail cannot say it all, otherwise generated from feeDetail."
            },
            "rrule": {
              "$ref": "common.schema.json#/$defs/rrule"
            },
            "anchor": {
              "$ref": "common.schema.json#/$defs/scheduleAnchor"
            },
            "frequency": {
              "enum": ["once"],
              "description": "For a licence that is not renewed; anything that recurs is written as an rrule."
            },
            "feeDetail": {
              "$ref": "common.schema.json#/$defs/feeDetail"
            },
            "penalty": {
              "$ref": "common.schema.json#/$defs/penalty"
            }
          }
        }
      ]
    },
    "local": {
      "description": "Typical general local licensing in the state.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "authority", "description", "url"],
      "properties": {
        "url": {
          "$ref": "common.schema.json#/$defs/httpsUrlList"
        },
        "title": {
          "type": "string"
        },
        "authority": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "dbaFiling": {
      "description": "Where a sole proprietor's trade name (DBA) is registered; none = no filing required.",
      "enum": ["state", "county", "town", "none"]
    },
    "dbaEntitiesFileLocally": {
      "type": "boolean"
    },
    "dbaOffice": {
      "description": "Name of the county or town office when dbaFiling is county or town.",
      "type": "string"
    },
    "dbaAuthority": {
      "description": "State agency taking trade names when it is not the entity filing agency.",
      "$ref": "#/$defs/agency"
    },
    "industry": {
      "description": "State licensing authorities by industry.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contractor", "realEstate", "alcohol", "childCare", "health"],
      "properties": {
        "contractor": {
          "type": ["string", "null"]
        },
        "realEstate": {
          "type": "string",
          "minLength": 3
        },
        "alcohol": {
          "type": "string",
          "minLength": 3
        },
        "childCare": {
          "type": "string",
          "minLength": 3
        },
        "health": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "cannabis": {
      "description": "State cannabis licensing regime.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "regulator"],
      "properties": {
        "status": {
          "enum": ["adult_use", "medical_only", "cbd_only"]
        },
        "regulator": {
          "type": ["string", "null"]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "links": {
      "description": "Specific agency pages (not home pages) for the obligations the rules cite.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formation",
        "annualReport",
        "uiRegistration",
        "withholding",
        "salesTax",
        "entityTax",
        "laborPosters",
        "dba"
      ],
      "properties": {
        "formation": {
          "$ref": "common.schema.json#/$defs/httpsUrlList"
        },
        "annualReport": {
          "$ref": "common.schema.json#/$defs/httpsUrlList"
        },
        "uiRegistration": {
          "$ref": "common.schema.json#/$defs/httpsUrlList"
        },
        "withholding": {
          "$ref": "common.schema.json#/$defs/httpsUrlList"
        },
        "salesTax": {
          "$ref": "common.schema.json#/$defs/httpsUrlList"
        },
        "entityTax": {
          "$ref": "common.schema.json#/$defs/httpsUrlList"
        },
        "laborPosters": {
          "$ref": "common.schema.json#/$defs/httpsUrlList"
        },
        "dba": {
          "$ref": "common.schema.json#/$defs/httpsUrlList"
        }
      }
    },
    "verification": {
      "description": "What was checked, when, and against which sources.",
      "type": "object",
      "additionalProperties": false,
      "required": ["checkedOn", "sources", "unconfirmed"],
      "properties": {
        "checkedOn": {
          "$ref": "common.schema.json#/$defs/isoDate",
          "description": "Date (YYYY-MM-DD) of the review."
        },
        "scope": {
          "type": "string",
          "minLength": 10,
          "description": "What the review covered. Stored only when it differs from the shared text in data/verification.json."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/httpsUrl"
          },
          "description": "Official pages the review relied on."
        },
        "unconfirmed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z]+(\\.[A-Za-z]+)*$"
          },
          "description": "Dotted field paths that could not be confirmed against an official source (checked against the data by a test). dbaFiling here means the DBA level is unconfirmed."
        }
      }
    }
  },
  "$defs": {
    "agency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3
        },
        "url": {
          "$ref": "common.schema.json#/$defs/httpsUrlList"
        }
      }
    },
    "due": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/dueDate"
        },
        {
          "$ref": "common.schema.json#/$defs/dueFixed"
        },
        {
          "$ref": "common.schema.json#/$defs/dueAnniversary"
        }
      ]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feeDetail", "penalty"],
      "properties": {
        "title": {
          "type": "string"
        },
        "rrule": {
          "$ref": "common.schema.json#/$defs/rrule",
          "description": "iCalendar (RFC 5545) recurrence rule. The source of truth for frequency and due date; see src/rrule.ts for the supported subset."
        },
        "anchor": {
          "$ref": "common.schema.json#/$defs/scheduleAnchor"
        },
        "opens": {
          "type": "object",
          "additionalProperties": false,
          "required": ["month", "day"],
          "properties": {
            "month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31
            }
          },
          "description": "The day a filing window opens; the rule's date is the day it closes. Gives text such as \"January 1 – May 1\"."
        },
        "frequency": {
          "enum": ["periodic"],
          "description": "Only for a report with no regular schedule; anything that recurs is written as an rrule."
        },
        "deadline": {
          "type": "string",
          "minLength": 1,
          "description": "Full deadline text, only for what the rule cannot say (for example \"Before the first day of the anniversary month\"). Generated from rrule when omitted."
        },
        "deadlineNote": {
          "type": "string",
          "minLength": 3,
          "description": "Qualifier shown in parentheses after the generated deadline (\"calendar-year filers\"). Must not repeat the rule's own date."
        },
        "fee": {
          "type": "string",
          "minLength": 1,
          "description": "Fee text; stored only when feeDetail cannot say it all (a waiver, an estimate, a rate), otherwise generated from feeDetail."
        },
        "feeDetail": {
          "$ref": "common.schema.json#/$defs/feeDetail"
        },
        "penalty": {
          "$ref": "common.schema.json#/$defs/penalty"
        }
      },
      "oneOf": [
        {
          "required": ["rrule"]
        },
        {
          "required": ["frequency", "deadline"]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": ["rrule"]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["frequency"]
                },
                {
                  "required": ["due"]
                }
              ]
            }
          },
          "else": {
            "not": {
              "required": ["anchor"]
            }
          }
        },
        { "$ref": "common.schema.json#/$defs/exactSchedule" }
      ]
    }
  },
  "description": "One state's rule data (data/states/<XX>.json; the file name is the state code)."
}
