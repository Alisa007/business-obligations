{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Alisa007/business-obligations/schema/cities.schema.json",
  "title": "City rule data (one file per state)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["state", "city", "items"],
    "properties": {
      "state": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "city": {
        "type": "string",
        "minLength": 2,
        "pattern": "^\\S(.*\\S)?$"
      },
      "aliases": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 2
        }
      },
      "status": {
        "enum": ["rules", "none", "unverified"]
      },
      "checkedOn": {
        "type": "string",
        "format": "date",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Date (YYYY-MM-DD) the entry was checked against official pages. Absent = never individually checked."
      },
      "sourceUrl": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "note": {
        "type": "string",
        "minLength": 10,
        "pattern": "^\\S(.*[.)])$"
      },
      "items": {
        "type": "array",
        "items": {
          "$ref": "local-item.schema.json"
        }
      },
      "counties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "items": {
              "minItems": 1
            }
          }
        },
        "then": {
          "not": {
            "required": ["status"],
            "properties": {
              "status": {
                "enum": ["none", "unverified"]
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "items": {
              "maxItems": 0
            }
          }
        },
        "then": {
          "required": ["status"]
        }
      },
      {
        "if": {
          "required": ["status"],
          "properties": {
            "status": {
              "const": "none"
            }
          }
        },
        "then": {
          "required": ["sourceUrl", "checkedOn"]
        }
      }
    ]
  }
}
