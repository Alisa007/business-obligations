{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Alisa007/business-obligations/schema/common.schema.json",
  "title": "Shared definitions",
  "description": "Definitions reused by the other schemas, so each rule is written once.",
  "$defs": {
    "isoDate": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Calendar date, YYYY-MM-DD."
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#]+/(?:[^?#/][^#]*|\\?[^#]+)(?:#.*)?$",
      "description": "A specific https source page; bare domains and root URLs are not valid citations."
    },
    "httpsUrlOrList": {
      "description": "One https URL, or a list when the answer is spread over several official pages.",
      "oneOf": [
        {
          "$ref": "#/$defs/httpsUrl"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/httpsUrl"
          }
        }
      ]
    },
    "httpsUrlList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/httpsUrl"
      }
    },
    "feeConditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "op", "value"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "op": { "enum": [">=", ">", "<=", "<", "==", "!=", "in"] },
          "value": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "description": { "type": "string" }
        }
      }
    },
    "stateCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "Two-letter USPS state code (includes DC)."
    },
    "rrule": {
      "type": "string",
      "pattern": "^(FREQ=YEARLY(;INTERVAL=[25])?(;BYMONTH=\\d{1,2}(,\\d{1,2})*)?(;BYMONTHDAY=-?\\d{1,2})?|FREQ=MONTHLY(;INTERVAL=3)?)$",
      "description": "iCalendar (RFC 5545) recurrence rule. The source of truth for frequency and due date; see src/rrule.ts for the supported subset."
    },
    "month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "dayOfMonth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31
    },
    "dueDate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "date"],
      "properties": {
        "type": {
          "const": "date"
        },
        "date": {
          "$ref": "#/$defs/isoDate"
        }
      }
    },
    "dueFixed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "month", "day"],
      "properties": {
        "type": {
          "const": "fixed"
        },
        "month": {
          "$ref": "#/$defs/month"
        },
        "day": {
          "$ref": "#/$defs/dayOfMonth"
        },
        "parity": {
          "enum": ["odd", "even"]
        },
        "cycleFrom": {
          "enum": ["formation_year", "year_after_formation"]
        }
      }
    },
    "dueAnniversary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "point"],
      "properties": {
        "type": {
          "const": "anniversary"
        },
        "point": {
          "enum": ["start_of_month", "end_of_month", "date"]
        }
      }
    },
    "dueMulti": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "dates"],
      "properties": {
        "type": {
          "const": "multi"
        },
        "quarterOf": {
          "const": "formation",
          "description": "Only the date in the calendar quarter that contains the formation (or registration) month applies."
        },
        "dates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["month", "day"],
            "properties": {
              "month": {
                "$ref": "#/$defs/month"
              },
              "day": {
                "$ref": "#/$defs/dayOfMonth"
              }
            }
          }
        }
      }
    },
    "rulesetVersion": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$",
      "description": "Ruleset version, YYYY-MM-DD.n."
    },
    "penalty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis"],
      "properties": {
        "basis": {
          "enum": ["flat", "percent", "per_item", "range", "none", "unknown"],
          "description": "flat = fixed charge; percent = percentage of a stated base; per_item = charge per filing or unit; range = a published minimum/maximum; none = no penalty; unknown = not yet researched."
        },
        "amount": { "type": "number", "minimum": 0 },
        "percentPerMonth": { "type": "number", "minimum": 0 },
        "note": { "type": "string", "minLength": 3 },
        "rate": { "type": "number", "minimum": 0 },
        "base": { "type": "number", "minimum": 0 },
        "perUnit": { "type": "number", "minimum": 0 },
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "basis": { "const": "flat" } } },
          "then": {
            "required": ["amount"],
            "not": {
              "anyOf": [{ "required": ["rate"] }, { "required": ["perUnit"] }, { "required": ["min"] }]
            }
          }
        },
        {
          "if": { "properties": { "basis": { "const": "percent" } } },
          "then": {
            "required": ["rate"],
            "not": { "anyOf": [{ "required": ["amount"] }, { "required": ["perUnit"] }] }
          }
        },
        {
          "if": { "properties": { "basis": { "const": "per_item" } } },
          "then": {
            "required": ["perUnit"],
            "not": { "anyOf": [{ "required": ["amount"] }, { "required": ["rate"] }] }
          }
        },
        {
          "if": { "properties": { "basis": { "const": "range" } } },
          "then": {
            "required": ["min"],
            "not": {
              "anyOf": [{ "required": ["amount"] }, { "required": ["rate"] }, { "required": ["perUnit"] }]
            }
          }
        },
        {
          "if": { "properties": { "basis": { "enum": ["none", "unknown"] } } },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["amount"] },
                { "required": ["rate"] },
                { "required": ["perUnit"] },
                { "required": ["min"] },
                { "required": ["max"] },
                { "required": ["percentPerMonth"] }
              ]
            }
          }
        }
      ]
    },
    "feeDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis"],
      "properties": {
        "basis": {
          "enum": ["flat", "per_partner", "per_member", "percent", "varies", "none", "tiered", "unknown"],
          "description": "none = the government charges nothing; varies = the fee depends on facts the data cannot know; unknown = not yet researched."
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "online": {
          "type": "number",
          "minimum": 0
        },
        "paper": {
          "type": "number",
          "minimum": 0
        },
        "rate": {
          "type": "number",
          "minimum": 0
        },
        "base": {
          "type": "number",
          "minimum": 0
        },
        "perUnit": {
          "type": "number",
          "minimum": 0
        },
        "freeUnits": {
          "type": "integer",
          "minimum": 0
        },
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "waived": {
          "type": "boolean"
        },
        "estimate": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "basis"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "basis": {
                "enum": ["flat", "per_partner", "per_member", "percent", "varies", "none"]
              },
              "when": { "$ref": "#/$defs/feeConditions" },
              "whenAny": { "$ref": "#/$defs/feeConditions" },
              "amount": { "type": "number", "minimum": 0 },
              "online": { "type": "number", "minimum": 0 },
              "paper": { "type": "number", "minimum": 0 },
              "rate": { "type": "number", "minimum": 0 },
              "base": { "type": "number", "minimum": 0 },
              "perUnit": { "type": "number", "minimum": 0 },
              "freeUnits": { "type": "integer", "minimum": 0 },
              "min": { "type": "number", "minimum": 0 },
              "max": { "type": "number", "minimum": 0 },
              "waived": { "type": "boolean" },
              "estimate": { "type": "boolean" },
              "note": { "type": "string" }
            },
            "allOf": [
              {
                "if": { "properties": { "basis": { "enum": ["flat", "none"] } } },
                "then": { "required": ["amount"] }
              },
              {
                "if": { "properties": { "basis": { "enum": ["per_partner", "per_member"] } } },
                "then": { "required": ["perUnit"] }
              },
              {
                "if": { "properties": { "basis": { "const": "percent" } } },
                "then": { "required": ["rate"] }
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "basis": { "const": "tiered" } }
          },
          "then": { "required": ["tiers"] }
        },
        {
          "if": {
            "properties": {
              "basis": {
                "enum": ["flat", "none"]
              }
            }
          },
          "then": {
            "required": ["amount"]
          }
        },
        {
          "if": {
            "properties": {
              "basis": {
                "enum": ["per_partner", "per_member"]
              }
            }
          },
          "then": {
            "required": ["perUnit"]
          }
        },
        {
          "if": {
            "properties": {
              "basis": {
                "const": "percent"
              }
            }
          },
          "then": {
            "required": ["rate"]
          }
        }
      ]
    }
  }
}
