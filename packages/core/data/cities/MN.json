        "id": "minneapolis.sick-and-safe-time",
        "title": "Provide Minneapolis sick and safe time",
        "category": "recordkeeping",
        "authority": "City of Minneapolis Labor Standards Enforcement",
        "description": "Employers must give employees paid sick and safe time: 1 hour for every 30 hours worked, up to 48 hours a year and 80 hours overall, or front-load 48 hours a year. Keep a written policy and give it to new hires, display the Minneapolis labor standards poster in each language spoken by 5% or more of employees, and show employees the hours used and available each pay period.",
        "frequency": "ongoing",
        "url": ["https://sicktimeinfo.minneapolismn.gov/employer-resources.html"],
