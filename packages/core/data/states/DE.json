  "llcReport": {
    "title": "Pay LLC annual tax",
    "rrule": "FREQ=YEARLY;BYMONTH=6;BYMONTHDAY=1",
    "feeDetail": {
      "basis": "flat",
      "amount": 400,
      "note": "annual tax"
    },
    "penalty": {
      "basis": "flat",
      "amount": 200,
      "percentPerMonth": 1.5,
      "note": "Plus 1.5% per month interest on the tax and penalty"
    }
  },
  "corpReport": {
    "title": "File annual franchise tax report",
    "rrule": "FREQ=YEARLY;BYMONTH=3;BYMONTHDAY=1",
    "feeDetail": {
      "basis": "varies",
      "min": 175,
      "note": "franchise tax, plus a $50 report fee"
    },
    "penalty": {
      "basis": "flat",
      "amount": 200,
      "percentPerMonth": 1.5,
      "note": "Plus 1.5% per month interest on the tax and penalty"
    }
  },
  "llpReport": {
    "title": "Pay LLP annual fee",
    "rrule": "FREQ=YEARLY;BYMONTH=6;BYMONTHDAY=1",
    "feeDetail": {
      "basis": "per_partner",
      "perUnit": 300,
      "max": 180000
    },
    "penalty": {
      "basis": "flat",
      "amount": 200,
      "percentPerMonth": 1.5,
      "note": "Plus 1.5% per month interest on the tax and penalty"
    }
  },
