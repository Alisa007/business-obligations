{
  "name": "business-obligations",
  "version": "0.13.0",
  "description": "Open-source TypeScript rules engine: describe a US business, get the licenses, permits, filings and deadlines it needs, ordered and sourced. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "schema",
    "data/states",
    "data/cities",
    "data/counties",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md",
    "COVERAGE.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:update": "vitest run -u",
    "check": "npm run typecheck && npm test",
    "prepack": "node scripts/prepack.mjs",
    "prepublishOnly": "npm run check && npm run build && npm run size",
    "coverage": "node scripts/coverage.mjs",
    "size": "node scripts/size.mjs",
    "check:links": "node scripts/check-urls.mjs --data",
    "report:stale": "node scripts/stale-report.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "author": "Alisa Belousova",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alisa007/business-obligations.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Alisa007/business-obligations/issues"
  },
  "homepage": "https://alisa007.github.io/business-obligations/",
  "keywords": [
    "annual-report",
    "business",
    "business-licenses",
    "business-registration",
    "calendar",
    "cli",
    "compliance",
    "compliance-calendar",
    "deadlines",
    "ein",
    "entity-formation",
    "esm",
    "filings",
    "ics",
    "legal-tech",
    "licenses",
    "llc",
    "nodejs",
    "open-data",
    "payroll",
    "permits",
    "regulatory-compliance",
    "rules-engine",
    "sales-tax",
    "small-business",
    "startup",
    "tax-deadlines",
    "typescript",
    "us",
    "workers-compensation",
    "zero-dependencies"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./zip": {
      "import": {
        "types": "./dist/zip.d.ts",
        "default": "./dist/zip.js"
      },
      "require": {
        "types": "./dist/zip.d.cts",
        "default": "./dist/zip.cjs"
      }
    },
    "./naics": {
      "import": {
        "types": "./dist/naics.d.ts",
        "default": "./dist/naics.js"
      },
      "require": {
        "types": "./dist/naics.d.cts",
        "default": "./dist/naics.cjs"
      }
    },
    "./locales": {
      "import": {
        "types": "./dist/locales/index.d.ts",
        "default": "./dist/locales/index.js"
      },
      "require": {
        "types": "./dist/locales/index.d.cts",
        "default": "./dist/locales/index.cjs"
      }
    },
    "./locales/en": {
      "import": {
        "types": "./dist/locales/en.d.ts",
        "default": "./dist/locales/en.js"
      },
      "require": {
        "types": "./dist/locales/en.d.cts",
        "default": "./dist/locales/en.cjs"
      }
    },
    "./locales/es": {
      "import": {
        "types": "./dist/locales/es.d.ts",
        "default": "./dist/locales/es.js"
      },
      "require": {
        "types": "./dist/locales/es.d.cts",
        "default": "./dist/locales/es.cjs"
      }
    },
    "./schema/*": "./schema/*",
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "sideEffects": false,
  "bin": {
    "business-obligations": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  }
}
