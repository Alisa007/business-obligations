{
  "name": "business-obligations-ui",
  "version": "0.5.0",
  "description": "Reusable React UI components for business-obligations launch plans and obligations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alisa007/business-obligations.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "business-obligations": ">=0.5.0",
    "react": ">=18",
    "tamagui": ">=3"
  },
  "devDependencies": {
    "@tamagui/config": "^3.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "business-obligations": "*",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tamagui": "^3.0.16",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
